@external propSource highlighting from "./highlight.js"
@top Program { (MixalOpLine | LineComment)* MixalOpLast }

MixalOpLine {
   (LOC Op Comment) "\n"
}

MixalOpLast {
   (LOC Op Comment) | ()
}

Comment {
   CommentText | ()
}

LOC {
   (LocalSymbol | Symbol | ()) space
}

Op {
    MixOpAddr | MixalPseudoOp | MixalALF | MixCHN
}

MixCHN {
   MixOpNameCHN
}

MixOpAddr {
    MixOp space Addr
}
MixOp {
    MixOpName
}
Addr {
    A_part I_part F_part
}
A_part {
    Expression | LiteralConstant | ()
}
I_part {
    "," Expression | ()
}
F_part {
    ("(" Expression ")") | ()
}

MixalPseudoOp {
    MixalOp WValue
}
MixalOp {
    MixPseudoOpName space
}
MixalALF {
    MixAlf " " ALF_Text
}
ALF_Text { MixAlphabet MixAlphabet  MixAlphabet MixAlphabet MixAlphabet}
Expression {
    AtomicExpression | (PlusOrMinus AtomicExpression) | (Expression BinaryOp AtomicExpression)
}
BinaryOp {
"+"|"-"|"*"|"/"|"//"|":"
}
AtomicExpression {
    Asterisk | LocalRefOrNumber | Symbol
}
LocalRefOrNumber {
    (Digit+) | (Digit LocalRefDir)
}
LiteralConstant {"=" WValue "="}
WValue {
    ExpressionAndFPart | (WValue "," ExpressionAndFPart)
}
ExpressionAndFPart {
    Expression F_part
}

@tokens {
  MixAlphabet {$[ a-zA-Z0-9.,()+\-*/=$<>@;:'ΔΣΠ]}
  space { $[ ]+ }
  LineComment { "*" ![\n]* "\n" }
  CommentText { space ![\n]* }
  "\n"
  LocalSymbol { $[0-9] h }
  Symbol { $[a-zA-Z]$[a-zA-Z0-9]* }

  Asterisk { "*" }
  Digit {$[0-9]}
  LocalRefDir {f | b}
  PlusOrMinus { $[+-] }
  MixOpName {
     a d d|
     c m p registers |
     d e c registers |
     d i v|
     e n n registers|
     e n t registers|
     i n c registers|
     i n|
     i o c|
     j registers n|
     j registers p|
     j registers z|
     j registers n n|
     j registers n p|
     j registers n z|
     j b u s|
     j e|
     j g|
     j (n|l|g) e|
     j m p|
     j n o v|
     j o v|
     j r e d|
     j s j|
     l d registers|
     l d registers n|
     s t (registers|j|z)|
     m o v e|
     m u l|
     n o p|
     o u t|
     s (l|r) (a|c)|
     s (l|r) a x|
     s u b
  }
  MixOpNameCHN {
    c h a r|
    n u m|
    h l t
  }
  MixPseudoOpName {
     e q u|
     o r i g|
     c o n|
     e n d
  }
  MixAlf {a l f}
  registers {$[123456aAxX]}
  a {$[aA]}
  b {$[bB]}
  c {$[cC]}
  d {$[dD]}
  e {$[eE]}
  f {$[fF]}
  g {$[gG]}
  h {$[hH]}
  i {$[iI]}
  j {$[jJ]}
  // k {$[kK]}
  l {$[lL]}
  m {$[mM]}
  n {$[nN]}
  o {$[oO]}
  p {$[pP]}
  q {$[qQ]}
  r {$[rR]}
  s {$[sS]}
  t {$[tT]}
  u {$[uU]}
  v {$[vV]}
  // w {$[wW]}
  x {$[xX]}
  // y {$[yY]}
  z {$[zZ]}
}
